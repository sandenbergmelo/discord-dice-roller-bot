{
  "name": "discord-dice-roller-bot",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch ./src/index.ts",
    "start": "bun run .",
    "clean": "rimraf dist",
    "test": "vitest",
    "lint": "eslint .",
    "format": "eslint . --fix"
  },
  "dependencies": {
    "@magicyan/discord": "1.5.2",
    "@reliverse/reglob": "1.0.0",
    "chalk": "5.5.0",
    "discord.js": "14.22.1",
    "rou3": "0.7.3",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@rocketseat/eslint-config": "^3.0.12",
    "@types/bun": "latest",
    "eslint": "^9.35.0",
    "eslint-plugin-import-newlines": "^1.4.0",
    "rimraf": "^6.0.1",
    "typescript": "5.7.2",
    "vitest": "^3.2.4"
  },
  "imports": {
    "#env": [
      "./build/env.js"
    ],
    "#base": [
      "./build/discord/base/index.js"
    ],
    "#functions": [
      "./build/functions/index.js"
    ],
    "#database": [
      "./build/database/index.js"
    ],
    "#server": [
      "./build/server/index.js"
    ],
    "#menus": [
      "./build/menus/index.js"
    ],
    "#tools": [
      "./build/tools/index.js"
    ],
    "#lib/*": [
      "./build/lib/*"
    ]
  },
  "baseVersion": "1.4.4"
}

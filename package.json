{
  "name": "discord-dice-roller-bot",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun --watch ./src/index.ts",
    "start": "bun .",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@constatic/base": "latest",
    "@magicyan/discord": "1.7.0",
    "chalk": "5.6.2",
    "discord.js": "14.25.1",
    "rou3": "0.7.12",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@rocketseat/eslint-config": "^3.0.12",
    "@types/bun": "^1.3.5",
    "eslint": "^9.39.2",
    "eslint-plugin-import-newlines": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.16"
  },
  "imports": {
    "#env": [
      "./build/env.js"
    ],
    "#base": [
      "./build/discord/index.js"
    ],
    "#functions": [
      "./build/functions/index.js"
    ],
    "#database": [
      "./build/database/index.js"
    ],
    "#server": [
      "./build/server/index.js"
    ],
    "#menus": [
      "./build/menus/index.js"
    ],
    "#tools": [
      "./build/tools/index.js"
    ],
    "#lib/*": [
      "./build/lib/*"
    ],
    "#shared/*": [
      "./build/shared/*"
    ]
  },
  "baseVersion": "1.5.2"
}
